            "uid": "${datasource}"
          },
          "queryType": "lucene",
          "query": "moodle.shortname:$shortname AND moodle_event.course:$course AND verb.id:$verb AND object.definition.type:$type",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "9",
              "type": "date_histogram",
