{
  "title": "Moodle - learning (xAPI)",
  "uid": "moodle-xapi",
  "tags": [
    "moodle",
    "opensearch",
    "xapi"
  ],
  "description": "xAPI statements of logstore_opensearch: engagement, funnel, performance, courses.",
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "grafana-opensearch-datasource",
        "current": {},
        "hide": 0
      },
      {
        "name": "shortname",
        "label": "Moodle",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"moodle.shortname\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"moodle.shortname\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "course",
        "label": "Course",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"moodle_event.course\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"moodle_event.course\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "verb",
        "label": "Verb",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"verb.id\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"verb.id\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      },
      {
        "name": "type",
        "label": "Activity type",
        "type": "query",
        "datasource": {
          "type": "grafana-opensearch-datasource",
          "uid": "${datasource}"
        },
        "query": "{\"find\": \"terms\", \"field\": \"object.definition.type\", \"size\": 500}",
        "definition": "{\"find\": \"terms\", \"field\": \"object.definition.type\", \"size\": 500}",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "hide": 0
      }
    ]
